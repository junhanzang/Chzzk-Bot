{
  "name": "chzzk-desk",
  "version": "0.8.0",
  "private": true,
  "description": "치지직 멀티뷰, 통나무 자동 수령과 로컬 리플레이 보관함",
  "author": "Chzzk Desk contributors",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node ../scripts/check-desk.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:extension": "node --test ../browser-extension/tests/*.test.cjs",
    "test:smoke": "node scripts/smoke.cjs",
    "test:replay": "node scripts/replay-integration.cjs",
    "test:browser-replay": "node scripts/replay-integration.cjs --browser-bridge",
    "test:clip-lengths": "node scripts/replay-integration.cjs --browser-bridge --all-durations",
    "test:auto-clip": "node scripts/auto-clip-integration.cjs",
    "test:session-replay": "node scripts/session-replay-integration.cjs",
    "test:auth": "node scripts/auth-smoke.cjs",
    "pack:win": "electron-builder --config electron-builder.cjs --win --x64 --dir --publish never",
    "dist:win": "electron-builder --config electron-builder.cjs --win --x64 --publish never",
    "verify:package": "node scripts/verify-package.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "45.2.1",
    "electron-builder": "26.15.3",
    "playwright-core": "1.63.0"
  }
}
